{
  "expo": {
    "name": "Daylight",
    "slug": "daylight-life-planner",
    "scheme": "daylight",
    "version": "1.0.0",
    "ios": {
      "bundleIdentifier": "com.yaarti.daylight",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "name": "Daylight",
      "shortName": "Daylight",
      "themeColor": "#f7f6f2",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cc2cce9d-f3f3-4c65-ad39-13d6e0fa4eca"
      }
    }
  }
}
